---

<section class="section section--alt" id="contact">
  <div class="container contact-inner">
    <div class="contact-left">
      <p class="section-label">Contact</p>
      <h2 class="section-title">Get In Touch</h2>
      <p class="contact-desc">
        Whether you have a question, a project idea, or just want to connect —
        my inbox is always open. I'll do my best to get back to you.
      </p>

      <ul class="social-list">
        {socials.map(({ label, value, href, icon }) => (
          <li>
            <a href={href} target={href.startsWith('mailto') ? '_self' : '_blank'}
              rel="noopener noreferrer" class="social-card">
              <span class="social-icon" set:html={icon} />
              <span class="social-info">
                <span class="social-label">{label}</span>
                <span class="social-value">{value}</span>
              </span>
              <svg class="social-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="contact-right">
      <form
        class="contact-form"
        action="https://formspree.io/f/mnjgkjeo"
        method="POST"
      >
        <h3 class="form-title">Send a message</h3>

        <div class="form-row">
          <div class="form-group">
            <label for="contact-name" class="form-label">Name</label>
            <input
              id="contact-name"
              type="text"
              name="name"
              class="form-input"
              placeholder="Your name"
              required
            />
          </div>
          <div class="form-group">
            <label for="contact-email" class="form-label">Email</label>
            <input
              id="contact-email"
              type="email"
              name="email"
              class="form-input"
              placeholder="your@email.com"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="contact-message" class="form-label">Message</label>
          <textarea
            id="contact-message"
            name="message"
            class="form-input form-textarea"
            placeholder="What's on your mind?"
            rows="5"
            required
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary form-submit">
          Send Message
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-desc {
    margin-top: 1rem;
    font-size: 1.0625rem;
    color: var(--clr-text-secondary);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  /* Social cards */
  .social-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background-color: var(--clr-bg);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .social-card:hover {
    border-color: var(--clr-accent);
    box-shadow: var(--shadow-md);
    transform: translateX(4px);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background-color: var(--clr-accent-light);
    color: var(--clr-accent);
    flex-shrink: 0;
  }

  .social-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex: 1;
    min-width: 0;
  }
  .social-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--clr-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .social-value {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--clr-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .social-arrow {
    color: var(--clr-text-muted);
    transition: color 0.15s, transform 0.15s;
  }
  .social-card:hover .social-arrow {
    color: var(--clr-accent);
    transform: translateX(3px);
  }

  /* Contact form */
  .contact-form {
    background-color: var(--clr-bg);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .form-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--clr-text);
    margin-bottom: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--clr-text-secondary);
  }

  .form-input {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--clr-text);
    background-color: var(--clr-bg-alt);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--radius);
    padding: 0.625rem 0.875rem;
    width: 100%;
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
  }
  .form-input::placeholder { color: var(--clr-text-muted); }
  .form-input:focus {
    border-color: var(--clr-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  .form-submit { width: 100%; justify-content: center; margin-top: 0.25rem; }

  @media (max-width: 900px) {
    .contact-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

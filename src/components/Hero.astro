---

<section class="hero" id="home">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-greeting">Hi, I'm</p>
      <h1 class="hero-name">Ellis Wright</h1>
      <p class="hero-title">
        Senior Software Engineer
        <span class="hero-company">@ Palo Alto Networks</span>
      </p>
      <p class="hero-tagline">
        Building secure, scalable software. Passionate about machine identity,
        distributed systems, and the developer experience.
      </p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">View My Work</a>
        <!-- TODO add back in resume link once it is ready/included -->
        <a href="/resume.pdf" download class="btn btn-secondary" style="visibility: hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download Resume
        </a>
      </div>
    </div>

    <div class="hero-avatar-wrap">
      <div class="hero-avatar" aria-hidden="true">
        <img src="/profile.JPG" alt="Ellis Wright" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    background-color: var(--clr-bg);
    /* Subtle dot-grid pattern */
    background-image: radial-gradient(circle, #e2e8f0 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .hero-content {
    flex: 1;
    max-width: 580px;
    animation: fadeInUp 0.55s ease-out both;
  }

  .hero-greeting {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--clr-accent);
    margin-bottom: 0.375rem;
  }

  .hero-name {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--clr-text);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 500;
    color: var(--clr-text-secondary);
    margin-bottom: 1.5rem;
  }

  .hero-company {
    color: var(--clr-accent);
    font-weight: 600;
  }

  .hero-tagline {
    font-size: 1.0625rem;
    color: var(--clr-text-secondary);
    line-height: 1.75;
    margin-bottom: 2.25rem;
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  /* Avatar */
  .hero-avatar-wrap {
    flex-shrink: 0;
    animation: fadeInUp 0.55s 0.15s ease-out both;
  }

  .hero-avatar {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(135deg, var(--clr-accent-light) 0%, #dbeafe 100%);
    border: 3px solid #bfdbfe;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5.5rem;
    font-weight: 800;
    color: var(--clr-accent);
    letter-spacing: -6px;
    box-shadow: var(--shadow-lg);
    animation: avatarPulse 5s ease-in-out infinite;
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes avatarPulse {
    0%, 100% { box-shadow: var(--shadow-lg), 0 0 0 0 rgba(37, 99, 235, 0.12); }
    50%       { box-shadow: var(--shadow-lg), 0 0 0 18px rgba(37, 99, 235, 0); }
  }

  @media (max-width: 768px) {
    .hero-inner {
      flex-direction: column-reverse;
      text-align: center;
      padding-top: 2.5rem;
    }
    .hero-tagline { margin-inline: auto; }
    .hero-actions { justify-content: center; }
    .hero-avatar  { width: 180px; height: 180px; font-size: 3.5rem; letter-spacing: -4px; }
  }
</style>

---
// TODO: These three labels could use some work. Like the years of experience label
// but the other two seem stupid
const stats = [
  { value: '4+',  label: 'Years of Experience' },
  { value: '5+', label: 'Features Lead' },
  { value: '15+', label: 'Technologies Used' },
];
---

<section class="section" id="about">
  <div class="container about-inner">
    <div class="about-text">
      <p class="section-label">About</p>
      <h2 class="section-title">A bit about me</h2>
      <div class="about-bio">
        <p>
          I'm a Senior Software Engineer at <strong>Palo Alto Networks</strong>, where I work on
          <a href="https://github.com/cyberark/conjur">Conjur</a> and it's various integrations.
          My work spans API design, distributed systems, and internal developer tooling.
          I pride myself on writing code that's highly functional, well tested, and
          maintainable.
        </p>
        <p>
          Outside of work, I enjoy skiing and rock climbing and am always tinkering on side projects
          that scratch an itch or solve a problem I've run into at work.
        </p>
      </div>
    </div>

    <div class="about-aside">
      <div class="about-stats">
        {stats.map(({ value, label }) => (
          <div class="stat-card">
            <span class="stat-value">{value}</span>
            <span class="stat-label">{label}</span>
          </div>
        ))}
      </div>

      <div class="about-currently">
        <h3 class="about-currently-title">Currently</h3>
        <ul class="about-currently-list">
          <li>
            <span class="dot"></span>
            Senior SWE @ Palo Alto Networks
          </li>
          <li>
            <span class="dot"></span>
            Building distributed systems for managing machine & human identities
          </li>
          <li>
            <span class="dot"></span>
            Exploring Golang, Ruby & Containerization
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
  }

  .about-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .about-bio p {
    font-size: 1.0625rem;
    color: var(--clr-text-secondary);
    line-height: 1.8;
  }
  .about-bio strong { color: var(--clr-text); font-weight: 600; }
  .about-bio a {
    color: var(--clr-accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }
  .about-bio a:hover { text-decoration-color: var(--clr-accent); }

  /* Stats */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .stat-card {
    background-color: var(--clr-bg-alt);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1rem;
    text-align: center;
  }
  .stat-value {
    display: block;
    font-size: 1.875rem;
    font-weight: 800;
    color: var(--clr-accent);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.375rem;
  }
  .stat-label {
    font-size: 0.75rem;
    color: var(--clr-text-muted);
    font-weight: 500;
    line-height: 1.3;
  }

  /* Currently */
  .about-currently {
    background-color: var(--clr-bg-alt);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .about-currently-title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-text-muted);
    margin-bottom: 1rem;
  }
  .about-currently-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .about-currently-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--clr-text-secondary);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--clr-accent);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .about-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-stats { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 480px) {
    .about-stats { grid-template-columns: 1fr 1fr; }
  }
</style>

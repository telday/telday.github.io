---
const projects = [
  {
    title: 'Data URL',
    category: 'Python Library',
    description:
      'An open-source library for creating and managing Data URLs according to RFC 2397.',
    tech: ['Python', 'PyPi', 'GitHub Actions'],
    github: 'https://github.com/telday/data_url',
    demo: '', //Can add a link here in the future for hosted site/use case
  },
];
---

<section class="section section--alt" id="projects">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Work</p>
      <h2 class="section-title">Personal Projects</h2>
      <p class="section-desc">
        A selection of things I've built in my own time — tools I wanted to exist,
        problems I wanted to solve.
      </p>
    </div>

    <ul class="projects-grid">
      {projects.map(({ title, category, description, tech, github, demo }) => (
        <li class="project-card">
          <div class="project-card-top">
            <span class="project-category">{category}</span>
            <div class="project-links">
              {github && (
                <a href={github} target="_blank" rel="noopener noreferrer"
                  class="project-icon-link" aria-label={`${title} on GitHub`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19"
                    viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                </a>
              )}
              {demo && (
                <a href={demo} target="_blank" rel="noopener noreferrer"
                  class="project-icon-link" aria-label={`${title} live demo`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17"
                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
              )}
            </div>
          </div>

          <h3 class="project-title">{title}</h3>
          <p class="project-desc">{description}</p>

          <div class="project-tech">
            {tech.map(t => <span class="tag">{t}</span>)}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-header { margin-bottom: 3rem; }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    background-color: var(--clr-bg);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .project-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.125rem;
  }

  .project-category {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clr-accent);
    background-color: var(--clr-accent-light);
    border: 1px solid #bfdbfe;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .project-links {
    display: flex;
    gap: 0.375rem;
  }

  .project-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius);
    color: var(--clr-text-muted);
    background-color: var(--clr-bg-alt);
    border: 1px solid var(--clr-border);
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .project-icon-link:hover {
    color: var(--clr-text);
    border-color: var(--clr-accent);
    background-color: var(--clr-accent-light);
  }

  .project-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--clr-text);
    letter-spacing: -0.01em;
    margin-bottom: 0.625rem;
  }

  .project-desc {
    font-size: 0.9375rem;
    color: var(--clr-text-secondary);
    line-height: 1.7;
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <About />
    <Projects />
    <Skills />
    <Contact />
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>
        &copy; {new Date().getFullYear()} Ellis Wright &mdash; Built with
        <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
        &middot; Hosted on
        <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a>
      </p>
    </div>
  </footer>
</Layout>

<style>
  .site-footer {
    padding: 2rem 0;
    border-top: 1px solid var(--clr-border);
  }
  .site-footer .container {
    display: flex;
    justify-content: center;
  }
  .site-footer p {
    font-size: 0.875rem;
    color: var(--clr-text-muted);
  }
  .site-footer a {
    color: var(--clr-accent);
    transition: color 0.15s;
  }
  .site-footer a:hover { color: var(--clr-accent-dark); }
</style>
